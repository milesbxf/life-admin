{
  "mcpServers": {
    "cronometer": {
      "command": "uvx",
      "args": ["cronometer-mcp==2.0.3"],
      "env": {
        "CRONOMETER_USERNAME": "${CRONOMETER_USERNAME}",
        "CRONOMETER_PASSWORD": "${CRONOMETER_PASSWORD}"
      }
    },
    "paprika": {
      "command": "/Users/milesbryant/.local/bin/paprika-mcp",
      "args": [],
      "env": {
        "PAPRIKA_USERNAME": "${PAPRIKA_USERNAME}",
        "PAPRIKA_PASSWORD": "${PAPRIKA_PASSWORD}"
      }
    },
    "spoonacular": {
      "command": "node",
      "args": ["node_modules/.bin/spoonacular-mcp"],
      "env": {
        "SPOONACULAR_API_KEY": "${SPOONACULAR_API_KEY}"
      }
    },
    "weather": {
      "command": "node",
      "args": ["node_modules/.bin/weather-mcp"]
    },
    "apple-events": {
      "command": "node",
      "args": ["tools/apple-events-mcp/bin/run.cjs"]
    },
    "whoop": {
      "command": "node",
      "args": ["tools/whoop-mcp/dist/index.js"],
      "env": {
        "WHOOP_CLIENT_ID": "${WHOOP_CLIENT_ID}",
        "WHOOP_CLIENT_SECRET": "${WHOOP_CLIENT_SECRET}",
        "WHOOP_REDIRECT_URI": "${WHOOP_REDIRECT_URI}"
      }
    }
  }
}
